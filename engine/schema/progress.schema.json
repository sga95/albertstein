{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://albertstein.link/engine/schema/progress.schema.json",
  "title": "progress.json",
  "description": "Stato del percorso: livelli, missioni, binari, incidenti. Lo edita solo Alberto.",
  "type": "object",
  "required": [
    "tiers",
    "missions",
    "tracks",
    "incidents"
  ],
  "additionalProperties": false,
  "properties": {
    "repo": {
      "type": "string",
      "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "tiers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/tier"
      }
    },
    "missions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/mission"
      }
    },
    "tracks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/track"
      }
    },
    "incidents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/incident"
      }
    },
    "quests": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/quest"
      }
    }
  },
  "$defs": {
    "tier": {
      "type": "object",
      "required": [
        "id",
        "name",
        "line",
        "missions",
        "boss"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "type": "string"
        },
        "missions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "boss": {
          "type": "object",
          "required": [
            "title",
            "done",
            "badge"
          ],
          "additionalProperties": false,
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1
            },
            "done": {
              "type": "boolean"
            },
            "badge": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "mission": {
      "type": "object",
      "required": [
        "n",
        "title",
        "done",
        "skill"
      ],
      "additionalProperties": false,
      "properties": {
        "n": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "done": {
          "type": "boolean"
        },
        "skill": {
          "type": "string",
          "minLength": 1
        },
        "file": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+\\.md$"
        }
      }
    },
    "track": {
      "type": "object",
      "required": [
        "id",
        "name",
        "line",
        "file",
        "steps"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "type": "string"
        },
        "file": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+\\.md$"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "requires": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "boss": {
              "type": "integer",
              "minimum": 1
            },
            "mission": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "step": {
      "type": "object",
      "required": [
        "n",
        "title",
        "done",
        "skill"
      ],
      "additionalProperties": false,
      "properties": {
        "n": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "done": {
          "type": "boolean"
        },
        "skill": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "incident": {
      "type": "object",
      "required": [
        "date",
        "title",
        "url"
      ],
      "additionalProperties": false,
      "properties": {
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "quest": {
      "type": "object",
      "required": [
        "id",
        "title",
        "done"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "done": {
          "type": "boolean"
        }
      }
    }
  }
}
